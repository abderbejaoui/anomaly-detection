# Port to expose the service on the host (host:container)
PORT=8000

# Google Earth Engine configuration
# Path on the HOST to the service account key JSON; will be mounted to /secrets/gee-key.json
GEE_KEY_HOST_PATH=./gee-key.json
# Inside-container path (do not change unless you change the volume mapping)
EE_SERVICE_ACCOUNT_KEY=/secrets/gee-key.json

# Optional: your GEE project ID
EE_PROJECT_ID=

# Logging
ENVIRONMENT=production
LOG_LEVEL=INFO

# Bootstrap options
SEED_ON_START=true
TRAIN_ON_START=false

# ----------------------------------------------------------------------------
# Olive zone classifier (POST /api/analyze)
# ----------------------------------------------------------------------------

# Sentinel Hub (Copernicus) OAuth credentials used to fetch Sentinel-2 imagery
# for the zone classification flow. Leave blank to fall back to mock imagery.
CLIENT_ID=sh-e24842a9-179e-461c-83e4-117aa992051a
CLIENT_SECRET=uqJMOpZXZozt0MnqgWbbEJDCKXTihzEX

# Hugging Face repo holding the olive model weights
OLIVE_CNN_HF_REPO=bassem404x/cnn_olive

# Filename inside that repo. Format auto-detected:
#   .pt / .pth   -> PyTorch VGG16 checkpoint
#   .h5 / .keras -> Keras saved model
OLIVE_CNN_FILENAME=olive.pt

# Comma-separated class names, in the order the model outputs them.
# NOTE: until the real model is published, the /api/analyze endpoint runs
# a deterministic mock classifier (extensif / intensif / not_olive).
OLIVE_CNN_CLASSES=Peacock_Spot,Rust_Mite,Healthy

# Optional: HF token if the repo is private
# HF_TOKEN=
