# Port to expose the service on the host (host:container)
PORT=8000

# Google Earth Engine configuration
# Path on the HOST to the service account key JSON; will be mounted to /secrets/gee-key.json
GEE_KEY_HOST_PATH=./gee-key.json
# Inside-container path (do not change unless you change the volume mapping)
EE_SERVICE_ACCOUNT_KEY=/secrets/gee-key.json

# Optional: your GEE project ID
EE_PROJECT_ID=

# Logging
ENVIRONMENT=production
LOG_LEVEL=INFO

# Bootstrap options
SEED_ON_START=true
TRAIN_ON_START=false
